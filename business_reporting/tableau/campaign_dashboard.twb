<workbook original-version='18.1' source-build='2026.2.0 (20262.26.0528.2205)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <SheetIdentifierTracking />
    <SortTagCleanup />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences />
  <datasources>
    <datasource caption='KAG_conversion_data' inline='true' name='federated.kagads01' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='tableau_ads' name='textscan.kagads01'>
            <connection class='textscan' directory='C:/Users/amarg/Documents/tableau_ads' filename='KAG_conversion_data.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.kagads01' name='KAG_conversion_data.csv' table='[KAG_conversion_data#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='ad_id' ordinal='0' />
            <column datatype='string' name='Campaign' ordinal='1' />
            <column datatype='string' name='fb_campaign_id' ordinal='2' />
            <column datatype='string' name='age' ordinal='3' />
            <column datatype='string' name='gender' ordinal='4' />
            <column datatype='integer' name='interest' ordinal='5' />
            <column datatype='integer' name='Impressions' ordinal='6' />
            <column datatype='integer' name='Clicks' ordinal='7' />
            <column datatype='real' name='Spend' ordinal='8' />
            <column datatype='integer' name='Total_Conversion' ordinal='9' />
            <column datatype='integer' name='Approved_Conversion' ordinal='10' />
          </columns>
        </relation>
      </connection>
      <column datatype='string' name='[Campaign]' role='dimension' type='nominal' />
      <column datatype='string' name='[ad_id]' role='dimension' type='nominal' />
      <column datatype='string' name='[fb_campaign_id]' role='dimension' type='nominal' />
      <column datatype='integer' name='[interest]' role='dimension' type='ordinal' />
      <column caption='CPA' datatype='real' name='[Calculation_20261105150000_001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Approved_Conversion]) = 0 THEN NULL ELSE SUM([Spend]) / SUM([Approved_Conversion]) END' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.000%' name='[Calculation_20261105150000_002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Impressions]) = 0 THEN NULL ELSE SUM([Clicks]) / SUM([Impressions]) END' />
      </column>
      <column caption='CPC' datatype='real' name='[Calculation_20261105150000_003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Clicks]) = 0 THEN NULL ELSE SUM([Spend]) / SUM([Clicks]) END' />
      </column>
      <column caption='Spend Share' datatype='real' default-format='p0.00%' name='[Calculation_20261105150000_004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Spend]) / TOTAL(SUM([Spend]))' />
      </column>
    </datasource>
